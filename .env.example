# Local development needs NO env file: PGlite + a generated data/.session-secret.
# Copy to .env only to override something.

# Local database (PGlite, in-process Postgres). Default ./data/pglite.
PGLITE_DATA_DIR=./data/pglite
# Session signing key, >= 32 chars. REQUIRED in production (Vercel env var).
SESSION_SECRET=replace-with-a-random-48-character-secret-string-xx
# Public origin for links in emails / copyable invite links (front door): https://your-studio.example
APP_URL=http://localhost:3000
# Outbound email (invite links, password resets). Set BOTH to send for real through Resend; otherwise the app
# logs one line per email (no token) and shows the copyable link in the UI instead.
RESEND_API_KEY=
EMAIL_FROM=Proofline <hello@your-studio.example>
# Optional: enables GET|POST /api/system/cron/sweep for an external scheduler (>= 32 chars).
# Call it with: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# PRODUCTION ONLY — never set these in .env / .env.local (the app would leave PGlite):
#   DATABASE_URL = Supabase transaction pooler (:6543), runtime, prepare:false
#   DIRECT_URL   = Supabase session pooler (:5432), migrations / bulk loads
# They live in Vercel env vars and, for the db:*:remote scripts, in .env.supabase (gitignored).
