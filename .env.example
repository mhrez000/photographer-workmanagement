# Local development needs NO env file: PGlite + a generated data/.session-secret.
# Copy to .env only to override something.

# Local database (PGlite, in-process Postgres). Default ./data/pglite.
PGLITE_DATA_DIR=./data/pglite
# Session signing key, >= 32 chars. REQUIRED in production (Vercel env var).
SESSION_SECRET=replace-with-a-random-48-character-secret-string-xx
# Public origin for links in emails / copyable invite links and the Google redirect URI: https://your-studio.example
# (production uses it first; local dev prefers the request's own address so a stale value never hands out dead links)
APP_URL=http://localhost:3000
# Outbound email (invite links, password resets, "Confirm your email", account notices). Set BOTH to send for real
# through Resend; otherwise the app logs one line per email (no token), shows copyable links instead, and email
# confirmation stays invisible. Setup steps: docs/ACCOUNTS.md §8.
RESEND_API_KEY=
EMAIL_FROM=Proofline <hello@your-studio.example>
# "Continue with Google" (docs/ACCOUNTS.md §8 B). Set BOTH to show the Google buttons; the OAuth client's redirect URI
# must be <APP_URL>/api/auth/google/callback (local dev: http://localhost:3130/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The demo studio's "Look around the demo" sign-in buttons. "off" closes the demo studio: no buttons
# (POST /api/auth/demo answers 404) and its shared accounts can't sign in with a password or Google either.
DEMO_SIGN_IN=on
# Number of reverse proxies whose X-Forwarded-For can be trusted for the client IP (rate limits per visitor).
# Vercel: 1 (a production server on Vercel warns once while it is missing). Locally: leave empty (0 = forwarding
# headers ignored; per-network limits then count per email or are skipped — never one bucket for everyone).
TRUSTED_PROXY_COUNT=
# Seeding only (npm run db:seed / db:reset): "off" seeds ordinary studios instead of demo studios (e2e:prepare sets it).
# SEED_DEMO=off
# Optional: enables GET|POST /api/system/cron/sweep for an external scheduler (>= 32 chars).
# Call it with: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# PRODUCTION ONLY — never set these in .env / .env.local (the app would leave PGlite):
#   DATABASE_URL = Supabase transaction pooler (:6543), runtime, prepare:false
#   DIRECT_URL   = Supabase session pooler (:5432), migrations / bulk loads
# They live in Vercel env vars and, for the db:*:remote scripts, in .env.supabase (gitignored).
# `vercel-build` migrates on PRODUCTION deploys only (VERCEL_ENV); MIGRATE_ON_BUILD=1 lets a preview with its OWN
# database migrate too. Never give a Preview the live database's DIRECT_URL.
